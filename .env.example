# ============================================================
# ForgeAI — Environment Configuration Example
# IMPORTANT: DO NOT COMMIT REAL API KEYS TO REPOSITORIES
# Copy this file to .env.local to configure your real credentials:
# cp .env.example .env.local
# ============================================================

# OpenAI API Key (GPT-6 Astra, Responses API)
OPENAI_API_KEY=your_openai_key

# Anthropic API Key (Claude Fable 5, Messages API)
ANTHROPIC_API_KEY=your_anthropic_key

# Google Gemini API Key (Gemini 2.0 Flash / 1.5 Pro)
GEMINI_API_KEY=your_gemini_key

# Local Model Endpoint (Optional, default: http://localhost:11434)
LOCAL_AI_BASE_URL=http://localhost:11434

# Notice: If no API keys are configured, ForgeAI runs seamlessly in
# high-fidelity simulation mode with model-specific architecture outputs.
